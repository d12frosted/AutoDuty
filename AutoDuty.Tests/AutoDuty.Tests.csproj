<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the parts of AutoDuty that are plain logic. The plugin itself targets windows and
    links against dalamud, which cannot run on a test host, so the files under test are compiled
    in here directly rather than referenced through the plugin assembly. Only files with no game
    dependencies can be linked this way.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../AutoDuty/Data/VariantRouteNaming.cs" Link="AutoDuty/VariantRouteNaming.cs" />
    <Compile Include="../AutoDuty/Data/VariantRoutePlan.cs" Link="AutoDuty/VariantRoutePlan.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
